<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <property name="now" value="now()" dbms="h2"/>

    <property name="now" value="current_timestamp" dbms="postgresql"/>


    <changeSet id="json-form-audit-remove-not-null" author="abdurahim">
      <dropNotNullConstraint tableName="json_form" columnName="created_by" columnDataType="varchar(50)"/>
      <dropNotNullConstraint tableName="json_form" columnName="created_date" columnDataType="timestamp"/>
    </changeSet>


</databaseChangeLog>
