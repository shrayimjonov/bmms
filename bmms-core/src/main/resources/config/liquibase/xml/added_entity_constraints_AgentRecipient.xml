<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity ReconcileDiscrepancy.
    -->
    <changeSet id="added_entity_constraints_AgentRecipient" author="zafar">

        <addColumn tableName="agent_recipient">
            <column name="recipient_group_id" type="bigint">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint baseColumnNames="recipient_group_id"
                                 baseTableName="agent_recipient"
                                 constraintName="fk_agent_recipient_recipient_group_id"
                                 referencedColumnNames="id"
                                 referencedTableName="recipient_group"/>

    </changeSet>
</databaseChangeLog>
