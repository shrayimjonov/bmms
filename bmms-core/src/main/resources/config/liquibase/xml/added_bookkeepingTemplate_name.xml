<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Deposit.
    -->
    <changeSet id="added_bookkeepingTemplate_name" author="zafar">

        <addColumn tableName="bookkeeping_template">

            <column name="name" type="varchar(64)" remarks="Уникальное название схемы бухгалтерского взаиморасчета" defaultValue="default_name">
                <constraints nullable="false"/>
            </column>

        </addColumn>

    </changeSet>
</databaseChangeLog>
