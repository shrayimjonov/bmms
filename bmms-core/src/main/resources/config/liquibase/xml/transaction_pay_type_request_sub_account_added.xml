<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Deposit.
    -->
    <changeSet id="transaction_pay_type_request_sub_account_added" author="israiloff">

        <addColumn tableName="transaction">
            <column name="pay_type" type="varchar(255)" defaultValue="UNKNOWN">
                <constraints nullable="false" />
            </column>
        </addColumn>

        <addColumn tableName="transaction">
            <column name="request_sub_account" type="varchar(32)">
                <constraints nullable="true" />
            </column>
        </addColumn>

    </changeSet>
</databaseChangeLog>
