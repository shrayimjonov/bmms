<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="added_index_tran_request_tr_id" author="javlon" context="dev or prod">

        <preConditions onFail="MARK_RAN">
            <columnExists tableName="transaction" columnName="request_login"/>
            <columnExists tableName="transaction" columnName="request_tr_id"/>
            <not>
                <indexExists tableName="transaction" indexName="idx_transaction_request_tr_id"/>
            </not>
        </preConditions>

        <comment>Create unique index (if not exist) idx_transaction_request_tr_id for columns request_login and request_tr_id in transaction table</comment>

        <createIndex indexName="idx_transaction_request_tr_id" tableName="transaction" unique="true">
            <column name="request_login" type="varchar(64)"/>
            <column name="request_tr_id" type="varchar(72)"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
