<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Deposit.
    -->
    <changeSet id="added_recipient_limit_ratio_column" author="javlon">

        <addColumn tableName="recipient">

            <column name="limit_ratio" type="integer" remarks="Разрядность макс. и мин. суммы платежа"
                    defaultValueNumeric="100">
                <constraints nullable="false"/>
            </column>

        </addColumn>

    </changeSet>
</databaseChangeLog>
