<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Deposit.
    -->
    <changeSet id="added_in_agent_recipient_group_setting" author="zafar">

        <addColumn tableName="agent_recipient">

            <column name="group_setting_id" type="bigint">
                <constraints nullable="true" />
            </column>

        </addColumn>

    </changeSet>

    <changeSet id="added_agent_recipient_group_setting_constraints" author="zafar">
        <addForeignKeyConstraint baseColumnNames="group_setting_id"
                                 baseTableName="agent_recipient"
                                 constraintName="fk_agent_recipient_group_setting_id"
                                 referencedColumnNames="id"
                                 referencedTableName="group_setting"/>
    </changeSet>



</databaseChangeLog>
