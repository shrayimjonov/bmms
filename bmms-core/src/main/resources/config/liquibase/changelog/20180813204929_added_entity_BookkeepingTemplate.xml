<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <property name="now" value="now()" dbms="h2"/>

    <property name="now" value="current_timestamp" dbms="postgresql"/>

    <property name="floatType" value="float4" dbms="postgresql, h2"/>
    <property name="floatType" value="float" dbms="mysql, oracle, mssql"/>

    <!--
        Added the entity BookkeepingTemplate.
    -->
    <changeSet id="20180813204929-1" author="jhipster">
        <createTable tableName="bookkeeping_template" remarks="Данная форма предназначена для создания шаблонов проводок в разрезе групп">
            <column name="id" type="bigint" autoIncrement="${autoIncrement}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="group_id" type="bigint" remarks="Группа">
                <constraints nullable="false" />
            </column>

            <column name="s_mfo" type="varchar(8)" remarks="МФО Отправителя">
                <constraints nullable="false" />
            </column>

            <column name="s_inn" type="varchar(16)" remarks="ИНН Отправителя">
                <constraints nullable="false" />
            </column>

            <column name="s_account" type="varchar(32)" remarks="Р/С Отправителя">
                <constraints nullable="false" />
            </column>

            <column name="r_mfo" type="varchar(8)" remarks="МФО Получателя">
                <constraints nullable="false" />
            </column>

            <column name="r_inn" type="varchar(16)" remarks="ИНН Получателя">
                <constraints nullable="false" />
            </column>

            <column name="r_account" type="varchar(32)" remarks="Р/С Получателя">
                <constraints nullable="false" />
            </column>

            <column name="calculate_amount_rule" type="varchar(64)" remarks="Правило расчета суммы, SUM(amount) - SUM(comission) - SUM(fee), ROUND(SUM(comission), 2)">
                <constraints nullable="false" />
            </column>

            <column name="period" type="varchar(255)">
                <constraints nullable="false" />
            </column>

            <column name="pay_types" type="varchar(50)">
                <constraints nullable="false" />
            </column>

            <column name="jhi_desc" type="varchar(128)">
                <constraints nullable="false" />
            </column>

            <column name="s_type" type="bigint">
                <constraints nullable="false" />
            </column>

            <column name="s_type_ids" type="varchar(128)">
                <constraints nullable="false" />
            </column>

            <column name="doc_type" type="varchar(8)">
                <constraints nullable="true" />
            </column>

            <column name="doc_code" type="varchar(16)" remarks="Код платежа">
                <constraints nullable="true" />
            </column>

            <column name="doc_task_code" type="varchar(8)" remarks="Код задачи">
                <constraints nullable="true" />
            </column>

            <column name="r_account_name" type="varchar(64)">
                <constraints nullable="true" />
            </column>

            <column name="control" type="bigint">
                <constraints nullable="true" />
            </column>

            <column name="gateway_id" type="bigint">
                <constraints nullable="true" />
            </column>

            <column name="recipient_id" type="bigint">
                <constraints nullable="true" />
            </column>

            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here, do not remove-->
        </createTable>
        
    </changeSet>
    
    <!-- Added the entity audit columns -->
    <changeSet id="20180823174713-audit-1" author="jhipster-entity-audit">
        <addColumn tableName="bookkeeping_template">
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp" defaultValueDate="${now}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </addColumn>
    </changeSet>
    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here, do not remove-->
</databaseChangeLog>
