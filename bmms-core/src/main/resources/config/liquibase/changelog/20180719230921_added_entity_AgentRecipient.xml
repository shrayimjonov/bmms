<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <property name="now" value="now()" dbms="h2"/>

    <property name="now" value="current_timestamp" dbms="postgresql"/>

    <property name="floatType" value="float4" dbms="postgresql, h2"/>
    <property name="floatType" value="float" dbms="mysql, oracle, mssql"/>

    <!--
        Added the entity AgentRecipient.
    -->
    <changeSet id="20180719230921-1" author="jhipster">
        <createTable tableName="agent_recipient" remarks="Доступные поставшики агенту">
            <column name="id" type="bigint" autoIncrement="${autoIncrement}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="agent_commission" type="double" remarks="Комиссия агента, которая снимается с внесенной суммы клиента в пользу агента">
                <constraints nullable="true" />
            </column>

            <column name="agent_fee" type="double" remarks="Вознаграждение агента, это отчисление системы с суммы платежа в пользу агента">
                <constraints nullable="true" />
            </column>

            <column name="system_commission_up" type="double" remarks="Комиссия системы, которая снимается сверх внесенной суммы клиента в пользу системы">
                <constraints nullable="true" />
            </column>

            <column name="system_commission_down" type="double" remarks="Комиссия системы, которая снимается с внесенной суммы клиента в пользу системы">
                <constraints nullable="true" />
            </column>

            <column name="system_fee" type="double" remarks="Вознаграждение системы, это отчисления поставщика услуг с суммы платежа в пользу системы">
                <constraints nullable="true" />
            </column>

            <column name="active" type="boolean">
                <constraints nullable="false" />
            </column>

            <column name="agent_id" type="bigint">
                <constraints nullable="true" />
            </column>

            <column name="recipient_id" type="bigint">
                <constraints nullable="true" />
            </column>

            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here, do not remove-->
        </createTable>
        
        <addUniqueConstraint
            columnNames="agent_id, recipient_id"
            constraintName="agent_recipient_unique"
            tableName="agent_recipient"
        />

    </changeSet>
    
    <!-- Added the entity audit columns -->
    <changeSet id="20180719230921-audit-1" author="jhipster-entity-audit">
        <addColumn tableName="agent_recipient">
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp" defaultValueDate="${now}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </addColumn>
    </changeSet>
    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here, do not remove-->
</databaseChangeLog>
