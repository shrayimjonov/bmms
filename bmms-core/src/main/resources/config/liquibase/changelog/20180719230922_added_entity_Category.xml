<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <property name="now" value="now()" dbms="h2"/>

    <property name="now" value="current_timestamp" dbms="postgresql"/>

    <property name="floatType" value="float4" dbms="postgresql, h2"/>
    <property name="floatType" value="float" dbms="mysql, oracle, mssql"/>

    <!--
        Added the entity Category.
    -->
    <changeSet id="20180719230922-1" author="jhipster">
        <createTable tableName="category" remarks="Категории поставшиков">
            <column name="id" type="bigint" autoIncrement="${autoIncrement}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="short_name" type="varchar(64)" remarks="Short name to show in UI">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="thumbnail" type="varchar(64)" remarks="Thumbnail file path or url">
                <constraints nullable="true" />
            </column>

            <column name="thumbnail_file" type="longblob" remarks="Thumbnail file">
                <constraints nullable="true" />
            </column>
            <column name="thumbnail_file_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>

            <column name="logo" type="varchar(64)" remarks="Logo file path or url">
                <constraints nullable="true" />
            </column>

            <column name="logo_file" type="longblob" remarks="Logo file">
                <constraints nullable="true" />
            </column>
            <column name="logo_file_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>

            <column name="ord" type="integer" remarks="Display order">
                <constraints nullable="true" />
            </column>

            <column name="active" type="boolean">
                <constraints nullable="false" />
            </column>

            <column name="parent_id" type="bigint">
                <constraints nullable="true" />
            </column>

            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here, do not remove-->
        </createTable>
        
        <createTable tableName="category_name">
            <column name="names_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="categories_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="categories_id, names_id" tableName="category_name"/>
        
    </changeSet>
    
    <!-- Added the entity audit columns -->
    <changeSet id="20180828190932-audit-1" author="jhipster-entity-audit">
        <addColumn tableName="category">
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp" defaultValueDate="${now}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </addColumn>
    </changeSet>
    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here, do not remove-->
</databaseChangeLog>
