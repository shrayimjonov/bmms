<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity RecipientGroup.
    -->
    <changeSet id="20191111230920-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="recipient_groups_id"
                                 baseTableName="recipient_group_recipient"
                                 constraintName="fk_recipient_group_recipient_recipient_groups_id"
                                 referencedColumnNames="id"
                                 referencedTableName="recipient_group"/>
        <addForeignKeyConstraint baseColumnNames="recipients_id"
                                 baseTableName="recipient_group_recipient"
                                 constraintName="fk_recipient_group_recipient_recipients_id"
                                 referencedColumnNames="id"
                                 referencedTableName="recipient"/>

    </changeSet>
</databaseChangeLog>
