<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity GroupSetting.
    -->
    <changeSet id="20190403230920-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="setting_type_id"
                                 baseTableName="group_setting"
                                 constraintName="fk_group_setting_setting_type_id"
                                 referencedColumnNames="id"
                                 referencedTableName="setting_type"/>

        <addForeignKeyConstraint baseColumnNames="group_settings_id"
                                 baseTableName="group_setting_prop"
                                 constraintName="fk_group_setting_prop_group_settings_id"
                                 referencedColumnNames="id"
                                 referencedTableName="group_setting"/>
        <addForeignKeyConstraint baseColumnNames="props_id"
                                 baseTableName="group_setting_prop"
                                 constraintName="fk_group_setting_prop_props_id"
                                 referencedColumnNames="id"
                                 referencedTableName="setting_property"/>
        
    </changeSet>
</databaseChangeLog>
