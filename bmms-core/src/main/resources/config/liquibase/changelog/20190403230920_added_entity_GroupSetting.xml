<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <property name="now" value="now()" dbms="h2"/>

    <property name="now" value="current_timestamp" dbms="postgresql"/>

    <property name="floatType" value="float4" dbms="postgresql, h2"/>
    <property name="floatType" value="float" dbms="mysql, oracle, mssql"/>

    <!--
        Added the entity GroupSetting.
    -->
    <changeSet id="20190403230920-1" author="jhipster">
        <createTable tableName="group_setting" remarks="Тип настройки">
            <column name="id" type="bigint" autoIncrement="${autoIncrement}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="request_group" type="varchar(64)" remarks="Группа - clearingNumber of terminal">
                <constraints nullable="false"/>
            </column>

            <column name="setting_type_id" type="bigint">
                <constraints nullable="false"/>
            </column>

            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here, do not remove-->
        </createTable>

        <createTable tableName="group_setting_prop">
            <column name="props_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="group_settings_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="group_settings_id, props_id" tableName="group_setting_prop"/>

    </changeSet>

    <!-- Added the entity audit columns -->
    <changeSet id="20190403230920-audit-1" author="jhipster-entity-audit">
        <addColumn tableName="group_setting">
            <column name="created_by" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="timestamp" defaultValueDate="${now}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
        </addColumn>
    </changeSet>
    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here, do not remove-->

    <changeSet id="added_unique_constraint_group_and_type" author="javlon">
        <addUniqueConstraint columnNames="setting_type_id, request_group"
                             constraintName="uc_group_setting_group_and_type"
                             tableName="group_setting"
        />
    </changeSet>
</databaseChangeLog>
