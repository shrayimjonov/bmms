<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <property name="now" value="now()" dbms="h2"/>

    <property name="now" value="current_timestamp" dbms="postgresql"/>

    <property name="floatType" value="float4" dbms="postgresql, h2"/>
    <property name="floatType" value="float" dbms="mysql, oracle, mssql"/>

    <!--
        Added the entity FieldValue.
    -->
    <changeSet id="20180719230925-1" author="jhipster">
        <createTable tableName="field_value">
            <column name="id" type="bigint" autoIncrement="${autoIncrement}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="jhi_value" type="varchar(64)" remarks="Param value to send to server">
                <constraints nullable="false" />
            </column>

            <column name="amount" type="bigint" remarks="Price of selected value">
                <constraints nullable="true" />
            </column>

            <column name="filter_by" type="varchar(16)" remarks="Filter the values (field.type=select) by parent field">
                <constraints nullable="true" />
            </column>

            <column name="ord" type="integer" remarks="Display order">
                <constraints nullable="true" />
            </column>

            <column name="field_id" type="bigint">
                <constraints nullable="false" />
            </column>

            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here, do not remove-->
        </createTable>
        
        <createTable tableName="field_value_title">
            <column name="titles_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="field_values_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="field_values_id, titles_id" tableName="field_value_title"/>
        
        <createTable tableName="field_value_description">
            <column name="descriptions_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="field_values_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="field_values_id, descriptions_id" tableName="field_value_description"/>
        
    </changeSet>
    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here, do not remove-->
</databaseChangeLog>
