<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <property name="now" value="now()" dbms="h2"/>

    <property name="now" value="current_timestamp" dbms="postgresql"/>

    <property name="floatType" value="float4" dbms="postgresql, h2"/>
    <property name="floatType" value="float" dbms="mysql, oracle, mssql"/>

    <!--
        Added the entity ReconcileSummary.
    -->
    <changeSet id="20181012204929-1" author="jhipster">
        <createTable tableName="reconcile_summary" remarks="Данная форма предназначена для хранения общих данных о сверке">
            <column name="id" type="bigint" autoIncrement="${autoIncrement}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="gateway_id" type="bigint" remarks="Уникальный номер шлюза">
                <constraints nullable="false" />
            </column>

            <column name="system_amount" type="bigint" remarks="Общая сумма системы">
                <constraints nullable="false" />
            </column>

            <column name="gateway_amount" type="bigint" remarks="Общая сумма шляза">
                <constraints nullable="false" />
            </column>

            <column name="system_count" type="bigint" remarks="Общее количество транзакций в системе">
                <constraints nullable="false" />
            </column>

            <column name="gateway_count" type="bigint" remarks="Общее количество транзакций у шлюза">
                <constraints nullable="false" />
            </column>

            <column name="jhi_date" type="date" remarks="Дата">
                <constraints nullable="true" />
            </column>

            <column name="success" type="boolean" remarks="Успешна ли сверка">
                <constraints nullable="true" />
            </column>

            <column name="period" type="varchar(255)" remarks="Период (день , месяц) и т.д.">
                <constraints nullable="true" />
            </column>

            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here, do not remove-->
        </createTable>
        
    </changeSet>
    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here, do not remove-->
</databaseChangeLog>
