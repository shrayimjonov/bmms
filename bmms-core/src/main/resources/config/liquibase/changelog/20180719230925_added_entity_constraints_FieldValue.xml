<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity FieldValue.
    -->
    <changeSet id="20180719230925-2" author="jhipster">
        
        <addForeignKeyConstraint baseColumnNames="field_id"
                                 baseTableName="field_value"
                                 constraintName="fk_field_value_field_id"
                                 referencedColumnNames="id"
                                 referencedTableName="field"/>

        <addForeignKeyConstraint baseColumnNames="field_values_id"
                                 baseTableName="field_value_title"
                                 constraintName="fk_field_value_title_field_values_id"
                                 referencedColumnNames="id"
                                 referencedTableName="field_value"/>
        <addForeignKeyConstraint baseColumnNames="titles_id"
                                 baseTableName="field_value_title"
                                 constraintName="fk_field_value_title_titles_id"
                                 referencedColumnNames="id"
                                 referencedTableName="i_18_n"/>
        
        <addForeignKeyConstraint baseColumnNames="field_values_id"
                                 baseTableName="field_value_description"
                                 constraintName="fk_field_value_description_field_values_id"
                                 referencedColumnNames="id"
                                 referencedTableName="field_value"/>
        <addForeignKeyConstraint baseColumnNames="descriptions_id"
                                 baseTableName="field_value_description"
                                 constraintName="fk_field_value_description_descriptions_id"
                                 referencedColumnNames="id"
                                 referencedTableName="i_18_n"/>
        
    </changeSet>
</databaseChangeLog>
