<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Entity ResponseField migrate to 7.1 jhipster
    -->
    <changeSet id="entity_ResponseField_migrate-1" author="zafar">
        <!--
             Rename column labels_id entity ResponseField
          -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="response_field_label"
                          columnName="labels_id"/>
        </preConditions>

        <comment>Rename column labels_id entity ResponseField</comment>

        <renameColumn tableName="response_field_label" oldColumnName="labels_id" newColumnName="label_id"/>
    </changeSet>

    <changeSet id="entity_ResponseField_migrate-2" author="zafar">
        <!--
            Rename column response_fields_id entity ResponseField
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="response_field_label"
                          columnName="response_fields_id"/>
        </preConditions>

        <comment>Rename column response_fields_id entity ResponseField</comment>

        <renameColumn tableName="response_field_label" oldColumnName="response_fields_id" newColumnName="response_field_id"/>
    </changeSet>

    <changeSet id="entity_ResponseField_migrate-3" author="zafar">
        <!--
            Drop primary key field_value_title
        -->
        <preConditions onFail="MARK_RAN">
            <primaryKeyExists tableName="response_field_label"/>
        </preConditions>

        <comment>Drop primary key response_field_label</comment>

        <dropPrimaryKey tableName="response_field_label"
                        dropIndex="true"/>
    </changeSet>

    <changeSet id="entity_ResponseField_migrate-4" author="zafar">
        <!--
            Rename table ResponseFieldLabel
        -->
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="response_field_label"/>
        </preConditions>

        <comment>Rename table ResponseFieldLabel</comment>

        <renameTable oldTableName="response_field_label" newTableName="rel_response_field__label"/>
    </changeSet>

    <changeSet id="entity_ResponseField_migrate-5" author="zafar">
        <!--
           Add primary key rel_response_field__label
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="rel_response_field__label"/>
            </not>
        </preConditions>

        <comment>Add primary key rel_response_field__label</comment>

        <addPrimaryKey columnNames="response_field_id, label_id" tableName="rel_response_field__label"/>
    </changeSet>

    <changeSet id="entity_ResponseField_migrate-6" author="zafar">
        <!--
         Add column created_by
       -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="response_field"
                              columnName="created_by"/>
            </not>
        </preConditions>

        <comment>Add column created_by</comment>

        <addColumn tableName="response_field">
            <column name="created_by" type="varchar(50)" defaultValue="system">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="entity_ResponseField_migrate-7" author="zafar">
        <!--
           Add column created_date
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="response_field"
                              columnName="created_date"/>
            </not>
        </preConditions>

        <comment>Add column created_date</comment>

        <addColumn tableName="response_field">
            <column name="created_date" type="timestamp" defaultValueDate="${now}">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="entity_ResponseField_migrate-8" author="zafar">
        <!--
          Add column last_modified_by
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="response_field"
                              columnName="last_modified_by"/>
            </not>
        </preConditions>

        <comment>Add column last_modified_by</comment>

        <addColumn tableName="response_field">
            <column name="last_modified_by" type="varchar(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="entity_ResponseField_migrate-9" author="zafar">
        <!--
         Add column last_modified_date
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="response_field"
                              columnName="last_modified_date"/>
            </not>
        </preConditions>

        <comment>Add column last_modified_date</comment>

        <addColumn tableName="response_field">
            <column name="last_modified_date" type="timestamp"/>
        </addColumn>

    </changeSet>
</databaseChangeLog>
