<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Drop foreign constraint recipient to recipient_title
    -->
    <changeSet id="drop_constraint_recipient_to_recipient_title" author="zafar" >
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="fk_recipient_title_recipients_id"/>
        </preConditions>

        <comment>Drop foreign constraint recipient to recipient title</comment>

        <dropForeignKeyConstraint baseTableName="rel_recipient__title"
                                  constraintName = "fk_recipient_title_recipients_id"/>

    </changeSet>
</databaseChangeLog>
