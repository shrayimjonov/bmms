<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Entity Category migrate to 7.1 jhipster
    -->
    <changeSet id="entity_Category_migrate-1" author="zafar">
        <!--
           Rename column names_id entity Category name
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="category_name"
                          columnName="names_id"/>
        </preConditions>

        <comment>Rename column names_id entity Category name</comment>

        <renameColumn tableName="category_name" oldColumnName="names_id" newColumnName="name_id"/>
    </changeSet>

    <changeSet id="entity_Category_migrate-2" author="zafar">
        <!--
            Rename column categories_id entity Category name
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="category_name"
                          columnName="categories_id"/>
        </preConditions>

        <comment>Rename column categories_id entity Category name</comment>

        <renameColumn tableName="category_name" oldColumnName="categories_id" newColumnName="category_id"/>
    </changeSet>

    <changeSet id="entity_Category_migrate-3" author="zafar">
        <!--
            Drop primary key category_name
        -->
        <preConditions onFail="MARK_RAN">
            <primaryKeyExists tableName="category_name"/>
        </preConditions>

        <comment>Drop primary key category_name</comment>

        <dropPrimaryKey tableName="category_name"
                        dropIndex="true"/>
    </changeSet>

    <changeSet id="entity_Category_migrate-4" author="zafar">
        <!--
            Rename table category name
        -->
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="category_name"/>
        </preConditions>

        <comment>Rename table category name</comment>

        <renameTable oldTableName="category_name" newTableName="rel_category__name"/>
    </changeSet>

    <changeSet id="entity_Category_migrate-5" author="zafar">
        <!--
           Add primary key rel_category__name
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="rel_category__name"/>
            </not>
        </preConditions>

        <comment>Add primary key category_name</comment>

        <addPrimaryKey columnNames="category_id, name_id" tableName="rel_category__name"/>
    </changeSet>
</databaseChangeLog>
