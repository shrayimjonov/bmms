<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Entity Field migrate to 7.1 jhipster
    -->
    <changeSet id="entity_Field_migrate-1" author="zafar">
        <!--
            Rename column jhi_type
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="field"
                          columnName="jhi_type"/>
        </preConditions>

        <comment>Rename column jhi_type</comment>

        <renameColumn tableName="field" oldColumnName="jhi_type" newColumnName="type"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-2" author="zafar">
        <!--
            Rename column jhi_validation
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="field"
                          columnName="jhi_validation"/>
        </preConditions>

        <comment>Rename column jhi_validation</comment>

        <renameColumn tableName="field" oldColumnName="jhi_validation" newColumnName="validation"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-3" author="zafar">
        <!--
           Rename column titles_id entity Field title
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="field_title"
                          columnName="titles_id"/>
        </preConditions>

        <comment>Rename column titles_id entity Field title</comment>

        <renameColumn tableName="field_title" oldColumnName="titles_id" newColumnName="title_id"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-4" author="zafar">
        <!--
            Rename column fields_id entity Field title
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="field_title"
                          columnName="fields_id"/>
        </preConditions>

        <comment>Rename column fields_id entity Field title</comment>

        <renameColumn tableName="field_title" oldColumnName="fields_id" newColumnName="field_id"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-5" author="zafar">
        <!--
            Drop primary key field_title
        -->
        <preConditions onFail="MARK_RAN">
            <primaryKeyExists tableName="field_title"/>
        </preConditions>

        <comment>Drop primary key field_title</comment>

        <dropPrimaryKey tableName="field_title"
                        dropIndex="true"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-6" author="zafar">
        <!--
            Rename table field title
        -->
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="field_title"/>
        </preConditions>

        <comment>Rename table field title</comment>

        <renameTable oldTableName="field_title" newTableName="rel_field__title"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-7" author="zafar">
        <!--
           Add primary key rel_field__title
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="rel_field__title"/>
            </not>
        </preConditions>

        <comment>Add primary key rel_field__title</comment>

        <addPrimaryKey columnNames="field_id, title_id" tableName="rel_field__title"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-8" author="zafar">
        <!--
           Rename column descriptions_id entity Field description
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="field_description"
                          columnName="descriptions_id"/>
        </preConditions>

        <comment>Rename column descriptions_id entity Field description</comment>

        <renameColumn tableName="field_description" oldColumnName="descriptions_id" newColumnName="description_id"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-9" author="zafar">
        <!--
            Rename column fields_id entity Field description
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="field_description"
                          columnName="fields_id"/>
        </preConditions>

        <comment>Rename column fields_id entity Field description</comment>

        <renameColumn tableName="field_description" oldColumnName="fields_id" newColumnName="field_id"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-10" author="zafar">
        <!--
            Drop primary key field title
        -->
        <preConditions onFail="MARK_RAN">
            <primaryKeyExists tableName="field_description"/>
        </preConditions>

        <comment>Drop primary key field_description</comment>

        <dropPrimaryKey tableName="field_description"
                        dropIndex="true"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-11" author="zafar">
        <!--
            Rename table field description
        -->
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="field_description"/>
        </preConditions>

        <comment>Rename table field_description</comment>

        <renameTable oldTableName="field_description" newTableName="rel_field__description"/>
    </changeSet>

    <changeSet id="entity_Field_migrate-12" author="zafar">
        <!--
           Add primary key rel_field__description
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="rel_field__description"/>
            </not>
        </preConditions>

        <comment>Add primary key rel_field__description</comment>

        <addPrimaryKey columnNames="field_id, description_id" tableName="rel_field__description"/>

    </changeSet>

    <changeSet id="entity_Field_migrate-13" author="zafar">
        <!--
          Add column created_by
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="field"
                              columnName="created_by"/>
            </not>
        </preConditions>

        <comment>Add column created_by</comment>

        <addColumn tableName="field">
            <column name="created_by" type="varchar(50)" defaultValue="system">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="entity_Field_migrate-14" author="zafar">
        <!--
           Add column created_date
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="field"
                              columnName="created_date"/>
            </not>
        </preConditions>

        <comment>Add column created_date</comment>

        <addColumn tableName="field">
            <column name="created_date" type="timestamp" defaultValueDate="${now}">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="entity_Field_migrate-15" author="zafar">
        <!--
          Add column last_modified_by
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="field"
                              columnName="last_modified_by"/>
            </not>
        </preConditions>

        <comment>Add column last_modified_by</comment>

        <addColumn tableName="field">
            <column name="last_modified_by" type="varchar(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="entity_Field_migrate-16" author="zafar">
        <!--
         Add column last_modified_date
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="field"
                              columnName="last_modified_date"/>
            </not>
        </preConditions>

        <comment>Add column last_modified_date</comment>

        <addColumn tableName="field">
            <column name="last_modified_date" type="timestamp"/>
        </addColumn>

    </changeSet>
</databaseChangeLog>
