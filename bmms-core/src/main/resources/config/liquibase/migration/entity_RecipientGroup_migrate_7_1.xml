<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Entity RecipientGroup migrate to 7.1 jhipster
    -->
    <changeSet id="entity_RecipientGroup_migrate-1" author="zafar">
        <!--
               Rename column recipients_id entity RecipientGroupRecipient
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="recipient_group_recipient"
                          columnName="recipients_id"/>
        </preConditions>

        <comment>Rename column recipients_id entity RecipientGroupRecipient</comment>

        <renameColumn tableName="recipient_group_recipient" oldColumnName="recipients_id" newColumnName="recipient_id"/>
    </changeSet>

    <changeSet id="entity_RecipientGroup_migrate-2" author="zafar">
        <!--
            Rename column recipient_groups_id entity RecipientGroupRecipient
        -->
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="recipient_group_recipient"
                          columnName="recipient_groups_id"/>
        </preConditions>

        <comment>Rename column recipient_groups_id entity RecipientGroupRecipient</comment>

        <renameColumn tableName="recipient_group_recipient" oldColumnName="recipient_groups_id" newColumnName="recipient_group_id"/>
    </changeSet>

    <changeSet id="entity_RecipientGroup_migrate-3" author="zafar">
        <!--
            Drop primary key recipient_group_recipient
        -->
        <preConditions onFail="MARK_RAN">
            <primaryKeyExists tableName="recipient_group_recipient"/>
        </preConditions>

        <comment>Drop primary key recipient_group_recipient</comment>

        <dropPrimaryKey tableName="recipient_group_recipient"
                        dropIndex="true"/>
    </changeSet>

    <changeSet id="entity_RecipientGroup_migrate-4" author="zafar">
        <!--
            Rename table recipient_group_recipient
        -->
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="recipient_group_recipient"/>
        </preConditions>

        <comment>Rename table recipient_group_recipient</comment>

        <renameTable oldTableName="recipient_group_recipient" newTableName="rel_recipient_group__recipient"/>
    </changeSet>

    <changeSet id="entity_RecipientGroup_migrate-5" author="zafar">
        <!--
           Add primary key rel_group_setting__prop
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="rel_recipient_group__recipient"/>
            </not>
        </preConditions>

        <comment>Add primary key rel_group_setting__prop</comment>

        <addPrimaryKey columnNames="recipient_group_id, recipient_id" tableName="rel_recipient_group__recipient"/>


    </changeSet>

    <changeSet id="entity_RecipientGroup_migrate-6" author="zafar">
        <!--
          Add column created_by
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="recipient_group"
                              columnName="created_by"/>
            </not>
        </preConditions>

        <comment>Add column created_by</comment>

        <addColumn tableName="recipient_group">
            <column name="created_by" type="varchar(50)" defaultValue="system">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="entity_RecipientGroup_migrate-7" author="zafar">
        <!--
           Add column created_date
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="recipient_group"
                              columnName="created_date"/>
            </not>
        </preConditions>

        <comment>Add column created_date</comment>

        <addColumn tableName="recipient_group">
            <column name="created_date" type="timestamp" defaultValueDate="${now}">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="entity_RecipientGroup_migrate-8" author="zafar">
        <!--
          Add column last_modified_by
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="recipient_group"
                              columnName="last_modified_by"/>
            </not>
        </preConditions>

        <comment>Add column last_modified_by</comment>

        <addColumn tableName="recipient_group">
            <column name="last_modified_by" type="varchar(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="entity_RecipientGroup_migrate-9" author="zafar">
        <!--
         Add column last_modified_date
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="recipient_group"
                              columnName="last_modified_date"/>
            </not>
        </preConditions>

        <comment>Add column last_modified_date</comment>

        <addColumn tableName="recipient_group">
            <column name="last_modified_date" type="timestamp"/>
        </addColumn>

    </changeSet>
</databaseChangeLog>
