<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Entity Field Value constraints migrate to 7.1 jhipster
    -->
    <changeSet id="entity_Field_Value_constraints_migrate-1" author="zafar">
        <!--
            Drop foreign constraint fieldValue to fieldValueTitle
        -->
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="fk_field_value_title_field_values_id"/>
        </preConditions>

        <comment>Drop foreign constraint fieldValue to fieldValueTitle</comment>

        <dropForeignKeyConstraint baseTableName="rel_field_value__title"
                                  constraintName = "fk_field_value_title_field_values_id"/>
    </changeSet>

    <changeSet id="entity_Field_Value_constraints_migrate-2" author="zafar">
        <!--
            Add foreign constraint fieldValue to fieldValueTitle
        -->
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_field_value_title_field_values_id"
                                            foreignKeyTableName="field_value"/>
            </not>
        </preConditions>

        <comment>Add foreign constraint fieldValue to fieldValueTitle</comment>

        <addForeignKeyConstraint baseColumnNames="field_value_id"
                                 baseTableName="rel_field_value__title"
                                 constraintName="fk_field_value_title_field_values_id"
                                 referencedColumnNames="id"
                                 referencedTableName="field_value"/>
    </changeSet>

