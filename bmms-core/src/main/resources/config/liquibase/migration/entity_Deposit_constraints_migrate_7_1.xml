<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Entity Deposit constraints migrate to 7.1 jhipster
    -->
    <changeSet id="entity_Deposit_constraints_migrate-1" author="zafar">
        <!--
            Drop foreign constraint deposit to recipient
        -->
        <preConditions onFail="MARK_RAN">
            <foreignKeyConstraintExists foreignKeyName="fk_deposit_recipient_id"/>
        </preConditions>

        <comment>Drop foreign constraint deposit to recipient</comment>

        <dropForeignKeyConstraint baseTableName="deposit"
                                  constraintName = "fk_deposit_recipient_id"/>
    </changeSet>


</databaseChangeLog>
