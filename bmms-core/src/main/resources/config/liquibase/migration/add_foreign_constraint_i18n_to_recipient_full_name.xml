<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added foreign constraint i18n to recipientFullName
    -->
    <changeSet id="add_foreign_constraint_i18n_to_recipient_full_name" author="zafar">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_recipient_full_name_full_names_id"
                                            foreignKeyTableName="i_18_n"/>
            </not>
        </preConditions>

        <comment>Add foreign constraint recipient to recipient full name</comment>
        <addForeignKeyConstraint baseColumnNames="full_name_id"
                                 baseTableName="rel_recipient__full_name"
                                 constraintName="fk_recipient_full_name_full_names_id"
                                 referencedColumnNames="id"
                                 referencedTableName="i_18_n"/>

    </changeSet>
</databaseChangeLog>
